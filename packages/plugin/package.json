{
  "name": "@tasarren/chromex",
  "version": "0.1.3",
  "description": "Local Chromium control for coding agents on Linux through an MCP bridge",
  "keywords": [
    "chromium",
    "mcp",
    "browser-automation",
    "coding-agents",
    "codex"
  ],
  "license": "MIT",
  "author": "Tasarren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasarren/chromex.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/tasarren/chromex#readme",
  "bugs": {
    "url": "https://github.com/tasarren/chromex/issues"
  },
  "type": "module",
  "bin": {
    "chromex": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/chromex"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "install:local": "node dist/cli.mjs setup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@chromex/extension": "workspace:*",
    "@chromex/mcp": "workspace:*",
    "@chromex/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:runtime",
    "@types/node": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "typescript": "catalog:tooling"
  }
}
