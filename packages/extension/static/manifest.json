{
  "manifest_version": 3,
  "name": "Codex Chromium Bridge",
  "version": "0.1.0",
  "description": "Locally connects Chromium tabs to a personal Codex MCP plugin.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["alarms", "debugger", "nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Codex Chromium Bridge"
  }
}
